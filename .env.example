# Brainule 2.0 — environment configuration
# Copy to .env and edit. Every value below is optional; the defaults shown are
# what the server uses when the variable is unset.

# ── Server ───────────────────────────────────────────────────────────────────
PORT=3000
# `production` disables the dev-only endpoints (/llm/smoke, /questions/:id)
NODE_ENV=development

# ── LLM provider ─────────────────────────────────────────────────────────────
# openai | gemini | mock
# `mock` needs no API key and makes no network calls — the full tutoring loop
# runs against canned responses.
LLM_PROVIDER=mock

# Overrides the adapter default (gpt-4o for openai, gemini-1.5-pro for gemini)
# LLM_MODEL=gpt-4o

# Required only for the provider you select
# OPENAI_API_KEY=sk-...
# GEMINI_API_KEY=...

# ── Content ──────────────────────────────────────────────────────────────────
# Relative paths resolve against the workspace root, not the working directory.
COURSE_DIR=course
PROMPTS_DIR=packages/prompts

# ── Storage ──────────────────────────────────────────────────────────────────
# Only `memory` is implemented — student state is lost when the server restarts.
# Google Sheets storage arrives with M12.
STORAGE_BACKEND=memory
# GOOGLE_SPREADSHEET_ID=

# ── Experimentation (reserved for M10 — currently unused) ────────────────────
EXPERIMENT_EPSILON=0.3
